# Configure AWS via `aws configure sso` + `aws sso login --profile ...`, an
# existing SDK credential source, or an AWS workload role. Do not commit keys.
# AWS_PROFILE=your-sso-profile
RAG_AWS_REGION=us-east-1
RAG_EXPECTED_AWS_ACCOUNT=054037143469
RAG_EMBED_MODEL=amazon.titan-embed-text-v2:0
RAG_TEXT_MODEL=amazon.nova-lite-v1:0

# TCPS EZConnect+: replace the illustrative host/service with connection info.
RAG_DB_DSN=tcps://your-database-host:1522/your-database-service
RAG_DB_USER=
RAG_DB_PASSWORD=
RAG_DB_WALLET_DIR=/absolute/path/to/Wallet_paulparkdbaws
RAG_DB_WALLET_PASSWORD=
RAG_EXPECTED_DB_NAME=paulparkdbaws
